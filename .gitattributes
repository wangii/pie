# Default to LF for text files across the repo
* text=auto eol=lf
# Windows scripts should keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
# Shell scripts should keep LF
*.sh text eol=lf
# Common binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.zip binary
*.gz binary
*.woff binary
*.woff2 binary
# Sarasa Term SC Nerd font is fetched at build time (see gui/cmake/FetchSarasaFont.cmake);
# do not store the ~283MB TTC in the repo, so no LFS rule is needed.
